  "dispositions": {
    "dependency_cycles": {
      "decision": "retained-blocking",
      "tool": "scripts/lib/module-graph.mjs (Tarjan over the first-party import graph)",
      "scope": "src, api, workers",
      "cadence": "every required CI run, through npm run check",
      "rationale": "An import cycle is a defect with a single correct response — break it — and the repository has none today, so a blocking gate with an empty baseline costs nothing and prevents the exact coupling the web shell's boot path is already prone to. This is the one analysis of the three with continuing value."
    },
    "unused_code": {
      "decision": "retained-ratchet",
      "tool": "scripts/verify-static-quality.mjs (export and dependency reachability over the first-party graph, tests and end-to-end suites included as consumers)",
      "scope": "exports declared under src/; runtime dependencies declared in the root package.json",
      "cadence": "every required CI run, through npm run check; the baseline is re-recorded deliberately with npm run quality:static:update",
      "rationale": "Dead exports accumulate silently, but a fully blocking gate would demand an unrelated dead-code sweep from whoever touches the repository next. Recording the existing findings and failing only on a new one is the honest middle: nothing is hidden, and the ratchet only ever asks a change to avoid making the number worse."
    },
    "duplication": {
      "decision": "retired",
      "tool": null,
      "scope": null,
      "cadence": null,
      "rationale": "Copy-paste duplication analysis is retired. It was an optional, non-blocking job in the donor repository and never a release gate; a duplication percentage over a React application is dominated by view scaffolding that should stay duplicated; and no reviewer action follows from the number. Retiring it is recorded here so the gap is deliberate rather than forgotten."
    }
  },
