<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/ug_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="16dp" android:gravity="center_vertical"
  android:background="@color/ug_widget_background">
  <TextView android:id="@+id/ug_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ug_widget_name" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ug_widget_foreground" />
  <TextView android:id="@+id/ug_widget_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="36sp" android:textStyle="bold" android:textColor="@color/ug_widget_foreground" />
  <TextView android:id="@+id/ug_widget_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ug_widget_unavailable" android:textSize="13sp" android:textColor="@color/ug_widget_foreground" />
  <TextView android:id="@+id/ug_widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ug_widget_open" android:textSize="11sp" android:textColor="@color/ug_widget_foreground" />
</LinearLayout>
