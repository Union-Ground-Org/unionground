<!-- Package-visibility declaration only: lets the app ask whether a calendar
     editor exists. No permission, no component, nothing exported. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <intent>
      <action android:name="android.intent.action.INSERT" />
      <data android:mimeType="vnd.android.cursor.dir/event" />
    </intent>
  </queries>
</manifest>
