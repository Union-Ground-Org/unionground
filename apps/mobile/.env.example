# Local development only. Staging and production values belong to their
# owner-approved EAS environments and must not be copied into this file.
# Union Ground has no provisioned backend yet: leave the Supabase values
# empty and the app runs its fictional preview. app.config.ts refuses any
# backend that is not pinned in source, and always refuses a sibling
# product's Supabase project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PREVIEW_ENABLED=1
# Optional per-platform Sentry projects. Empty means monitoring is a no-op.
# Use Union Ground's own projects only.
EXPO_PUBLIC_SENTRY_DSN_IOS=
EXPO_PUBLIC_SENTRY_DSN_ANDROID=
# Your product's own name (required for store builds). The Union Ground name,
# mark and icon are Union Ground LLC's trademarks: copies use their own
# (TRADEMARKS.md). OFFICIAL_BRANDING=1 is only for the LLC's own builds.
BRAND_NAME=
# Where this build's source code is offered (AGPL section 13). Point it at
# your own repository if you change the code.
# SOURCE_CODE_URL=https://github.com/Union-Ground-Org/unionground
