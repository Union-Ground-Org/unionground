    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "expo-doctor": "^1.20.2",
    "jsdom": "29.1.1",
    "pngjs": "3.4.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "xcode": "3.0.1"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "@expo/cli": {
      "zod": "4.6.7"
    },
    "@expo/config": {
      "deepmerge": "4.1.1"
    },
    "micromatch": "$micromatch",
    "decode-uri-component": "0.5.1",
    "node-forge": "1.4.3",
    "query-string": "9.5.1",
    "glob": "14.0.4",
    "minimatch": "11.0.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "doctor": "EXPO_OFFLINE=1 npm_config_loglevel=warn expo-doctor",
    "native-deps:check": "npm ls react-native-reanimated react-native-worklets expo-modules-core --all",
    "typecheck": "tsc --noEmit",
    "type-coverage": "node scripts/type-coverage-ratchet.mjs",
    "type-coverage:report": "node scripts/type-coverage-ratchet.mjs --report",
    "type-coverage:update": "node scripts/type-coverage-ratchet.mjs --update",
    "test": "vitest run",
    "test:root-suites": "node scripts/test-root-suites-for-mobile-change.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "deep-link:budget": "node scripts/verify-malformed-deep-link-budget.mjs --platform ios && node scripts/verify-malformed-deep-link-budget.mjs --platform android",
    "assets:generate": "node scripts/verify-icon.mjs --write",
    "assets:check": "node scripts/verify-icon.mjs",
    "contrast:audit": "node scripts/contrast-audit.mjs",
    "dark-ui:audit": "node scripts/dark-frame-icon-audit.mjs",
    "touch-targets:audit": "node scripts/touch-target-audit.mjs",
    "lovable:coverage:audit": "node scripts/lovable-coverage-audit.mjs",
    "proof:android:routes": "node scripts/android-route-proof.mjs",
    "bundle:check": "expo export --platform ios --output-dir dist/ios && node scripts/verify-malformed-deep-link-budget.mjs --platform ios --bundle-dir dist/ios && node scripts/verify-bundle-identity.mjs --bundle-dir dist/ios && expo export --platform android --output-dir dist/android && node scripts/verify-malformed-deep-link-budget.mjs --platform android --bundle-dir dist/android && node scripts/verify-bundle-identity.mjs --bundle-dir dist/android",
    "check": "npm run doctor && npm run native-deps:check && npm run security:audit && npm run typecheck && npm run type-coverage && npm run test && npm run assets:check && npm run contrast:audit && npm run dark-ui:audit && npm run touch-targets:audit && npm run lovable:coverage:audit && npm run bundle:check",
    "check:ci": "npm run doctor && npm run native-deps:check && npm run security:audit && npm run typecheck && npm run type-coverage && npm run assets:check && npm run contrast:audit && npm run dark-ui:audit && npm run touch-targets:audit && npm run lovable:coverage:audit && npm run bundle:check"
  },
  "private": true
}
