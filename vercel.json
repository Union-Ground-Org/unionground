{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["iad1"],
  "trailingSlash": false,
  "installCommand": "npm install",
  "buildCommand": "node scripts/fetch-filing-cjk-font.mjs && npm run check",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/notifications-dispatch", "schedule": "0 12 * * *" },
    { "path": "/api/connect-purge", "schedule": "17 3 * * *" },
    { "path": "/api/account-deletion-reconcile", "schedule": "*/10 * * * *" },
    { "path": "/api/engagement-delivery", "schedule": "*/15 * * * *" },
    { "path": "/api/integration-webhooks-dispatch", "schedule": "15 12 * * *" },
    { "path": "/api/task-files-reconcile", "schedule": "30 12 * * *" },
    { "path": "/api/calendar-sync", "schedule": "45 12 * * *" },
    { "path": "/api/constant-contact-sync", "schedule": "0 14 * * *" },
    { "path": "/api/organization-exports", "schedule": "15 * * * *" },
    { "path": "/api/private-upload-currency-canary", "schedule": "20 * * * *" },
    { "path": "/api/google-activations", "schedule": "*/15 * * * *" },
    { "path": "/api/platform-announcements-dispatch", "schedule": "*/5 * * * *" },
    { "path": "/api/scheduled-job-alerts", "schedule": "4-59/5 * * * *" },
    { "path": "/api/intake-topic-send-dispatch", "schedule": "*/2 * * * *" }
  ],
  "functions": {
    "api/guide.js": { "maxDuration": 90 },
    "api/account-lifecycle.js": { "maxDuration": 95 },
    "api/account-deletion-reconcile.js": { "maxDuration": 60 },
    "api/calendar-oauth.js": { "maxDuration": 60 },
    "api/calendar-sync.js": { "maxDuration": 60 },
    "api/constant-contact-oauth.js": { "maxDuration": 60 },
    "api/constant-contact-sync.js": { "maxDuration": 60 },
    "api/engagement-delivery.js": { "maxDuration": 300 },
    "api/google-drive.js": { "maxDuration": 60 },
    "api/google-activations.js": { "maxDuration": 60 },
    "api/integration-webhooks-dispatch.js": { "maxDuration": 300 },
    "api/integration-webhooks.js": { "maxDuration": 60 },
    "api/knowledge-ingest.js": { "maxDuration": 60 },
    "api/private-files.js": { "maxDuration": 60 },
    "api/private-upload-currency-canary.js": { "maxDuration": 30 },
    "api/scim.js": { "maxDuration": 30, "includeFiles": "config/account-blocked-email-domains.json" },
    "api/notifications-dispatch.js": { "maxDuration": 300 },
    "api/organization-exports.js": { "maxDuration": 60 },
    "api/task-files-reconcile.js": { "maxDuration": 300 },
    "api/form-filing.js": { "includeFiles": "{api/_lib/fonts/*.ttf,api/_lib/fonts/*.otf,api/_lib/fonts/*.txt,node_modules/harfbuzzjs/dist/harfbuzz-subset.wasm}" },
    "api/invite-request.js": {
      "includeFiles": "{content/legal/**,src/lib/{legal*.js,i18n{.js,/es.js}},apps/mobile/src/lib/legal*.ts,src/data/telemetry*.json,docs/legal/*.md,config/{legal-catalogue-pins,telemetry-disclosure-sources.d}/**,supabase/migrations/*.sql}"
    },
    "api/intake-review.js": {
      "includeFiles": "{content/legal/**,src/lib/{legal*.js,i18n{.js,/es.js}},apps/mobile/src/lib/legal*.ts,src/data/telemetry*.json,docs/legal/*.md,config/{legal-catalogue-pins,telemetry-disclosure-sources.d}/**,supabase/migrations/*.sql}"
    },
    "api/legal-pack.js": {
      "includeFiles": "{content/legal/**,src/lib/{legal*.js,i18n{.js,/es.js}},apps/mobile/src/lib/legal*.ts,src/data/telemetry*.json,docs/legal/*.md,config/{legal-catalogue-pins,telemetry-disclosure-sources.d}/**,supabase/migrations/*.sql}"
    },
    "api/platform-announcements-dispatch.js": { "maxDuration": 30 },
    "api/intake-topic-send-dispatch.js": { "maxDuration": 60 },
    "api/accept-invitation.js": { "includeFiles": "config/account-blocked-email-domains.json" },
    "api/admin-invitations.js": { "includeFiles": "config/account-blocked-email-domains.json" },
    "api/admin-signin-recovery.js": { "includeFiles": "config/account-blocked-email-domains.json" },
    "api/open-signup.js": {
      "includeFiles": "{content/legal/**,src/lib/{legal*.js,i18n{.js,/es.js}},apps/mobile/src/lib/legal*.ts,src/data/telemetry*.json,docs/legal/*.md,config/{legal-catalogue-pins/**,telemetry-disclosure-sources.d/**,account-blocked-email-domains.json},supabase/migrations/*.sql}"
    },
    "api/open-signup-confirm.js": {
      "includeFiles": "{content/legal/**,src/lib/{legal*.js,i18n{.js,/es.js}},apps/mobile/src/lib/legal*.ts,src/data/telemetry*.json,docs/legal/*.md,config/{legal-catalogue-pins/**,telemetry-disclosure-sources.d/**,account-blocked-email-domains.json},supabase/migrations/*.sql}"
    }
