# Your product's name and who runs this server (README.md, "Running your own
# copy"). A production build fails without VITE_BRAND_NAME, and a deployed
# server refuses sign-in until OPERATOR_NAME and OPERATOR_CONTACT_EMAIL are
# set. The Union Ground name and logo are Union Ground LLC's (TRADEMARKS.md):
# use your own. VITE_OFFICIAL_BRANDING=1 is only for the LLC's own builds.
VITE_BRAND_NAME=
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=
# OPERATOR_URL=https://your-organization.example
# OPERATOR_JURISDICTION=
# Where your build's source code is offered (AGPL section 13). Point it at your
# own repository if you change the code.
# SOURCE_CODE_URL=https://github.com/Union-Ground-Org/unionground
# Public browser configuration. RLS is the authorization boundary.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-project-browser-key
VITE_UNIONGROUND_SUPABASE_REF=your-project
# Union Ground has no provisioned backend, domain, SAMPLE project or
# telemetry. Every provider below stays off while its value is unset; never
# reuse a sibling product's project, host, DSN or key.
# Surface selection. Localhost and previews are the product site; the fixture
# demo is ?demo=1 on the same deployment.
# VITE_APP_SURFACE=saas
# A dedicated SAMPLE project only after the owner approves one.
# VITE_SAMPLE_SUPABASE_URL=https://your-sample-project.supabase.co
# VITE_SAMPLE_SUPABASE_PUBLISHABLE_KEY=replace-with-sample-publishable-key
# SAMPLE_SUPABASE_URL=https://your-sample-project.supabase.co
# SAMPLE_SUPABASE_PUBLISHABLE_KEY=replace-with-sample-publishable-key
# SAMPLE_SUPABASE_SERVICE_ROLE_KEY=replace-with-sample-service-role-key
# SAMPLE_PREVIEW_HOSTS=your-sample-preview.vercel.app
# Default web shell when a visit names none: alt or classic (unset is classic).
# VITE_UG_DEFAULT_SHELL=classic
# Privacy-limited product analytics and browser error monitoring. Unset means
# off; set only after the owner approves a Union Ground telemetry provider,
# and add its host to the Content-Security-Policy in vercel.json at the same time.
# VITE_POSTHOG_PROJECT_TOKEN=
# VITE_POSTHOG_HOST=
# VITE_SENTRY_DSN=
VITE_SENTRY_PREVIEW_ENABLED=0
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Server-only. Never expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-project-service-role-key
UNIONGROUND_SUPABASE_PROJECT_REF=your-project
# Optional: forward the end user's address to Supabase Auth on password
# sign-in (Sb-Forwarded-For) so its per-IP limit counts people, not this
# server. Set to 1 only after IP address forwarding is switched on in that
# project's Auth rate-limit settings and the server key above is an
# sb_secret_ key. SAMPLE_SUPABASE_AUTH_FORWARD_CLIENT_IP is the SAMPLE twin.
# SUPABASE_AUTH_FORWARD_CLIENT_IP=1
# Public /connect intake (server-only). The app URL is also the exact allowed
# browser origin. Generate the secret with 32 random bytes encoded as base64;
# retain old keys outside the repository while requests from that version exist.
UNIONGROUND_APP_URL=https://unionground.example.org/
# Generate: openssl rand -base64 32
UNIONGROUND_CONNECT_SECRET=
UNIONGROUND_CONNECT_KEY_VERSION=v1
# Keep both disabled until neutral contact verification and an audited reviewer
# queue are operational. The browser flag only reveals the form; the server flag
# independently controls acceptance.
VITE_UNIONGROUND_CONNECT_ENABLED=0
UNIONGROUND_CONNECT_ENABLED=0
# Final server-side interlock. Do not set unless ownership verification, the
# audited reviewer queue, and monitored purge have each been proven.
UNIONGROUND_CONNECT_ACTIVATION_CONFIRM=disabled
# Notification dispatch (server-only). CRON_SECRET authorizes
# /api/notifications-dispatch and must match the Supabase Vault secret
# 'notifications-dispatch-secret' that the pg_cron tick sends. It must be at
# least 32 characters: one floor, shared by every scheduled route
# (api/_lib/cronAuth.js) and by the /connect activation interlock. Every
# scheduled route answers 503 while it is absent, short or a placeholder.
# Generate: openssl rand -hex 32. The server refuses an empty, short (<32) or
# placeholder value ("replace-with...", "changeme", "example...").
CRON_SECRET=
# Optional Better Stack heartbeat for /api/private-upload-currency-canary. Each
# passing hourly tick pings it; a missed ping pages. Unset pings nothing.
PRIVATE_UPLOAD_CURRENCY_HEARTBEAT_URL=
# Optional calendar provider activation. Keep every value unset until a real
# customer supplies its own OAuth app and chooses to activate free/busy sync.
# These values are server-only; never expose them with VITE_ or EXPO_PUBLIC_.
# GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
# GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# MICROSOFT_CALENDAR_OAUTH_CLIENT_ID=
# MICROSOFT_CALENDAR_OAUTH_CLIENT_SECRET=
# MICROSOFT_CALENDAR_OAUTH_TENANT=
# CALENDAR_OAUTH_TOKEN_WRAP_KEY=
# SAMPLE uses separate credentials and a separate wrapping key. Leave these
# unset unless the SAMPLE operator deliberately activates the SAMPLE project.
# SAMPLE_GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
# SAMPLE_GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# SAMPLE_MICROSOFT_CALENDAR_OAUTH_CLIENT_ID=
# SAMPLE_MICROSOFT_CALENDAR_OAUTH_CLIENT_SECRET=
# SAMPLE_MICROSOFT_CALENDAR_OAUTH_TENANT=
# SAMPLE_CALENDAR_OAUTH_TOKEN_WRAP_KEY=
# Optional organization-owned Twilio activation. Each JSON array entry binds
# one provider AccountSid to one existing organization, a verified sending
# number, an HTTPS webhook origin, and its managed Auth Token. Keep this
# server-only and unset until that organization completes operator review.
# TWILIO_ACCOUNTS_JSON=[{"accountSid":"AC...","authToken":"...","organizationId":"...","fromNumber":"+15551234567","fromNumbers":["+15551234567"],"webhookBaseUrl":"https://unionground.example.org"}]
# SAMPLE_TWILIO_ACCOUNTS_JSON=[]
# Independent HMAC pepper for phone/SID digests retained in operation history.
# Generate: openssl rand -hex 32
# SMS_LEDGER_HASH_SALT=
# Optional organization-owned Constant Contact activation. Leave both values
# unset until a real organization registers its own OAuth application. Refresh
# tokens are stored in Supabase Vault, never in environment variables or the
# browser. SAMPLE uses separate keys and stays unset by default.
# CONSTANT_CONTACT_CLIENT_ID=
# CONSTANT_CONTACT_CLIENT_SECRET=
# SAMPLE_CONSTANT_CONTACT_CLIENT_ID=
# SAMPLE_CONSTANT_CONTACT_CLIENT_SECRET=
# Optional organization-owned Google Drive activation. These are server-only;
# the redirect must exactly match the OAuth client registration. Leave unset
# until a real organization chooses to connect its own Google account.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=https://unionground.example.org/api/google-drive?action=callback
# Integration webhook delivery uses a separate credential so SAMPLE cannot
# gain notification, reconciliation, or production-backend cron authority.
# Generate: openssl rand -hex 32. The server refuses an empty, short (<32) or
# placeholder value ("replace-with...", "changeme", "example...").
INTEGRATION_DISPATCH_SECRET=
SAMPLE_INTEGRATION_DISPATCH_SECRET=
# SAMPLE notification dispatch is push-only and never uses Vercel cron. Keep
# this server-only bearer distinct from CRON_SECRET and every Supabase API key;
# the API refuses collisions before its first database request.
# Generate: openssl rand -hex 32. The server refuses an empty, short (<32) or
# placeholder value ("replace-with...", "changeme", "example...").
SAMPLE_NOTIFICATION_DISPATCH_SECRET=
RESEND_API_KEY=replace-with-resend-api-key
NOTIFY_FROM_ADDRESS=Union Ground <alerts@example.org>
NOTIFY_APP_URL=https://unionground.example.org/m
# Signing secret of the mail provider's event webhook (Resend shows it starting
# whsec_). Unset means /api/account-mail-events refuses every call.
# RESEND_WEBHOOK_SECRET=
# Static fail-safe only. Vercel environment variables are baked into a
# deployment, so changing this in project settings does nothing until the next
# deploy — do NOT reach for it during an incident. The real emergency stop is
# in the database and takes effect within one claim cycle:
#   update private.notification_controls set outbound_enabled = false;
NOTIFY_KILL_SWITCH=0
# Optional, server-only. Primary credential for /api/guide: when set it takes
# precedence over Vercel OIDC. Leave it unset on Vercel so the deployment uses
# OIDC; any non-Vercel host has no OIDC to fall back to and MUST set this or the
# endpoint returns 503 for every member request.
# AI_GATEWAY_API_KEY=replace-with-ai-gateway-key
# SAMPLE-only static fail-safe. This never changes production dispatch.
SAMPLE_NOTIFY_KILL_SWITCH=0
# Accounts are invitation-only, so public sign-up must be OFF on the hosted
# Supabase project (Authentication > Sign In / Providers). While it is on, the
# deployment refuses to serve the app and the invitation endpoints. Set this
# only when open sign-up is intended:
# ALLOW_OPEN_SIGNUP=true
# Invitations use an app-owned, fragment-only,
# one-time link; the email also carries a QR code for the origin's /get-app page.
# The origin must be exact (no path or trailing slash). The rate secret HMACs
# network buckets before persistence; generate it independently from API keys.
INVITATION_APP_ORIGIN=https://unionground.example.org
# Generate: openssl rand -hex 32. The server refuses an empty, short (<32) or
# placeholder value ("replace-with...", "changeme", "example...").
INVITATION_RATE_LIMIT_SECRET=
# Open signup (D2e), behind the owner's public signup switch
# (REQ-UG-PUBLIC-SIGNUP-OWNER-SWITCH-20261003). The switch is the database
# signup period and ships off; while it is off these are ignored and accounts
# are invitation-only. Set them in the production Vercel environment only when
# the owner turns the switch on; leave them unset everywhere else.
# Generate: openssl rand -hex 32. The server refuses an empty, short (<32) or
# placeholder value ("replace-with...", "changeme", "example...").
OPEN_SIGNUP_SECRET=
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# Public-interest submissions use the same server-only pattern: an exact
# same-origin check and an independent HMAC key for opaque network buckets.
PUBLIC_SITE_APP_ORIGIN=https://unionground.example.org
# Generate: openssl rand -hex 32. The server refuses an empty, short (<32) or
# placeholder value ("replace-with...", "changeme", "example...").
PUBLIC_INTEREST_RATE_LIMIT_SECRET=
# Organization catalog-verification claims (/api/organization-claim*): an
# independent HMAC key (at least 32 characters) for the network and email rate
# scopes, and the platform verifier's mailbox. Claimant notices use it as
# reply-to and approval receipts go to it. The routes answer 503 when the
# mailbox is on a union family's national domain
# (config/catalog-family-domains.json).
# Generate: openssl rand -hex 32. The server refuses an empty, short (<32) or
# placeholder value ("replace-with...", "changeme", "example...").
ORGANIZATION_CLAIM_RATE_LIMIT_SECRET=
CLAIM_VERIFIER_EMAIL=verifier@example.invalid
# Web push (VAPID). The public key ships to the browser; the private key and
# contact are server-only.
VITE_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_CONTACT=mailto:alerts@example.org
# Native push provider credentials are server-only managed secrets. Do not put
# them in EAS public variables, Expo client configuration, repository evidence,
# or any VITE_/EXPO_PUBLIC_ variable. APNs routing is stored per installation,
# so the same token key serves both sandbox development builds and production.
# APNS_TEAM_ID=replace-with-10-character-apple-team-id
# APNS_KEY_ID=replace-with-10-character-apns-key-id
# APNS_PRIVATE_KEY=replace-with-managed-p8-private-key
# APNS_BUNDLE_ID=replace-with-unionground-bundle-id
# The native app's application id, which APNS_BUNDLE_ID must equal. Unset, it
# is the placeholder in config/mobile-release-foundation.json.
# MOBILE_APPLICATION_ID=org.example.unionground
# FCM_SERVICE_ACCOUNT_JSON=replace-with-managed-service-account-json

# --- AI assistant (server-only) ---
# The Guide (Compass) reaches only an approved in-house mesh
# (docs/superpowers/specs/2026-09-15-inhouse-ai-mesh-contract.md, section 3).
# Both layers are required per surface: the Cloudflare Access service token at
# the edge and the origin bearer the mesh proxy verifies. Production reads the
# unprefixed names; SAMPLE reads the SAMPLE_-prefixed ones. A missing value
# makes Compass answer 503 "not configured", never a fallback. Never expose any
# of these with VITE_.
# MESH_AI_API_KEY=replace-with-mesh-origin-bearer
# MESH_AI_ACCESS_CLIENT_ID=replace-with-cloudflare-access-client-id
# MESH_AI_ACCESS_CLIENT_SECRET=replace-with-cloudflare-access-client-secret
# SAMPLE_MESH_AI_API_KEY=replace-with-sample-mesh-origin-bearer
# SAMPLE_MESH_AI_ACCESS_CLIENT_ID=replace-with-sample-cloudflare-access-client-id
# SAMPLE_MESH_AI_ACCESS_CLIENT_SECRET=replace-with-sample-cloudflare-access-client-secret

# --- Local RLS verification (scripts/verify-local-rls.mjs) ---
# Points at the LOCAL `supabase start` stack, not production. SUPABASE_ANON_KEY
# is the anon/publishable key; the harness also reads SUPABASE_SERVICE_ROLE_KEY
# above to set up fixtures before dropping to anon for the policy assertions.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# Newer publishable/secret key pair, read by scripts/member-*.mjs when present.
SUPABASE_SECRET_KEY=replace-with-project-secret-key
VITE_SUPABASE_ANON_KEY=replace-with-project-anon-key

# --- Live DB contract (scripts/verify-db-contract.mjs, `npm run verify:db`) ---
# A direct Postgres connection string, because the checks it runs read pg_proc,
# pg_policy and has_*_privilege — none of which PostgREST can reach, so the
# supabase-js vars above are useless for this. Direct connections look like
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres;
# the pooler carries the ref in the username instead (postgres.<project-ref>).
# Either form is accepted, but the ref must match the one in
# scripts/db-contract.json — the script aborts before its first query otherwise,
# because verifying a different database against this contract only produces
# meaningless diffs. The script is READ-ONLY: it issues catalog SELECTs and
# nothing else. Leave this unset for ordinary development; `npm run verify:db`
# then prints SKIP and exits 0, which is also how CI behaves without the secret.
SUPABASE_DB_URL=replace-with-postgres-connection-string

# --- Local/demo visual assurance (scripts/visual-audit-runner.mjs) ---
# Safe local example. CI replaces the base URL and exact SHA with values from
# the deployment event; do not place token-bearing URLs here.
VISUAL_AUDIT_BASE_URL=http://127.0.0.1:4173
VISUAL_AUDIT_EXPECTED_SHA=replace-with-forty-character-commit-sha
VISUAL_AUDIT_ARTIFACT_DIR=./artifacts/visual-audit
# Default 1 appends ?demo=1 for local product-site previews. Set 0 when the
# host is already SAMPLE (VITE_APP_SURFACE=demo).
VISUAL_AUDIT_APPEND_DEMO=1
# Override only when deliberately testing a reviewed alternate baseline.
VISUAL_AUDIT_BASELINE_PATH=./config/visual-audit-baseline.json

# --- SAMPLE demo-chrome covenant proof (scripts/verify-demo-chrome-covenant.mjs) ---
# Asserts the merged PR #1511/#1522 promises directly: welcome-then-hat-intro
# ordering with focus handoff, and the bilingual rail/Work-tab/chapter label
# geometry at 1280x800, 1440x900, 1920x1080 and the 450px short-height viewport.
DEMO_COVENANT_BASE_URL=http://127.0.0.1:4173
# Optional separate SaaS preview.
# The shared loopback harness must leave VITE_APP_SURFACE unset.
DEMO_COVENANT_SAAS_BASE_URL=http://127.0.0.1:4173
DEMO_COVENANT_EXPECTED_SHA=replace-with-forty-character-commit-sha
DEMO_COVENANT_ARTIFACT_DIR=./artifacts/demo-chrome-covenant
# Default 1 appends ?demo=1 for local product-site previews. Set 0 on a SAMPLE host.
DEMO_COVENANT_APPEND_DEMO=1

# --- Other server settings (api/ and the build), unset unless turned on ---
# tests/server-settings-documented.test.js fails when code reads a name missing here.
# Set by Vercel in every build and deployment; never set by hand. Commit SHA tags
# releases; the URLs are the hosts an exact .vercel.app origin is checked against.
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_GIT_COMMIT_SHA=replace-with-forty-character-commit-sha
# VERCEL_URL=your-deployment.vercel.app
# VERCEL_BRANCH_URL=your-branch.vercel.app
# VERCEL_PROJECT_PRODUCTION_URL=unionground.example.org
# Set by the platform; anything but production lets a loopback origin use http.
# NODE_ENV=production
# Local test builds only: 1 loads the isolated e2e and visual-audit fixtures.
# VITE_E2E_HARNESS=1
# VITE_VISUAL_AUDIT=1
# Optional server analytics (PostHog). Both together, https host; unset sends nothing.
# POSTHOG_PROJECT_TOKEN=replace-with-public-posthog-project-token
# POSTHOG_HOST=https://posthog.example.org
# Optional: exactly "on" turns on heatmaps for public pages.
# POSTHOG_PUBLIC_HEATMAPS=on
# Optional: postal address in account and engagement email footers.
# ORG_POSTAL_ADDRESS=replace-with-mailing-address-for-email-footers
# Optional: the operator's published postal address. Topic-update mail to
# public-interest subscribers sends only once it is set.
# PUBLIC_POSTAL_ADDRESS=replace-with-published-mailing-address
# Local development only: "1" lets the server use a local http Supabase
# backend. Never set it on a deployment.
# UNIONGROUND_LOCAL_BACKEND=
# Official builds only: "1" draws the official marks from branding/official.
# Copies of Union Ground leave it unset and use their own name and logo.
# VITE_OFFICIAL_BRANDING=
# Optional Slack webhook for private operator alerts; unset only logs.
# UG_ALERTS_SLACK_WEBHOOK_URL=replace-with-slack-incoming-webhook-url
# Required for /api/steward-email-intake: HMAC key the mail relay signs with.
# STEWARD_EMAIL_INTAKE_SECRET=
# Required for /api/public/event-rsvp: HMAC key (32+ characters); else 503.
# PUBLIC_EVENT_RSVP_RATE_LIMIT_SECRET=
# Optional: "true" makes passkey sign-in require the key's PIN-verified flags.
# PIN_VERIFIED_KEY_MFA_ENABLED=true
# Optional: "enabled" lets admins register SAML SSO once SAML is on in Supabase.
# SSO_SAML_REGISTRATION=enabled
# Ignored on purpose: read only to report it was set; never forces a legal release.
# LEGAL_RELEASE_FORCE=
# Optional Compass: "on" adds hybrid retrieval; the endpoints may only restate
# each surface's own mesh host. Unset uses the built-in endpoint.
# COMPASS_HYBRID_RETRIEVAL=on
# MESH_AI_ENDPOINT=replace-with-production-mesh-chat-completions-url
# SAMPLE_MESH_AI_ENDPOINT=replace-with-sample-mesh-chat-completions-url
# Optional civic "resolve now" button: "true" turns it on; token dispatches the resolver.
# CIVIC_RESOLVER_ENABLED=true
# CIVIC_RESOLVER_DISPATCH_TOKEN=replace-with-workflow-dispatch-token
# CIVIC_RESOLVER_REPO=owner/repository
# Optional civic bill tracking: where the bill workflow is dispatched; unset sends none.
# CIVIC_DISPATCH_TOKEN=replace-with-workflow-dispatch-token
# CIVIC_WORKER_REPO=owner/repository
# CIVIC_WORKER_REF=main
# Optional engagement email: the cron posts each due email to the URL with the
# token; the key must differ from RESEND_API_KEY; SAMPLE sends only to the list.
# ENGAGEMENT_EMAIL_WEBHOOK_URL=https://unionground.example.org/api/engagement-email-bridge
# ENGAGEMENT_EMAIL_WEBHOOK_TOKEN=replace-with-long-random-bridge-token
# ENGAGEMENT_EMAIL_RESEND_API_KEY=replace-with-separate-resend-api-key
# ENGAGEMENT_EMAIL_BRIDGE_SAMPLE_RECIPIENTS=tester@example.invalid
# Required to encrypt sensitive fields: key-version JSON, active version, revoked
# organization ids. docs/security/sensitive-data-encryption.md. SAMPLE has its own.
# SENSITIVE_DATA_KEYS={"v1":"replace-with-base64-32-byte-key"}
# SENSITIVE_DATA_ACTIVE_KEY=v1
# SENSITIVE_DATA_REVOKED_ORGANIZATIONS=[]
# SAMPLE_SENSITIVE_DATA_KEYS={"v1":"replace-with-a-different-base64-32-byte-key"}
# SAMPLE_SENSITIVE_DATA_ACTIVE_KEY=v1
# SAMPLE_SENSITIVE_DATA_REVOKED_ORGANIZATIONS=[]
# Optional Stripe dues, all three together.
# STRIPE_DUES_CLIENT_ID=replace-with-stripe-connect-client-id
# STRIPE_DUES_SECRET_KEY=replace-with-stripe-secret-key
# STRIPE_DUES_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
# SAMPLE_STRIPE_DUES_CLIENT_ID=
# SAMPLE_STRIPE_DUES_SECRET_KEY=
# SAMPLE_STRIPE_DUES_WEBHOOK_SECRET=
# Optional Google organization calendar sync: OAuth client and exact https redirect.
# GOOGLE_ORG_CALENDAR_CLIENT_ID=
# GOOGLE_ORG_CALENDAR_CLIENT_SECRET=
# GOOGLE_ORG_CALENDAR_REDIRECT_URI=
# SAMPLE_GOOGLE_ORG_CALENDAR_CLIENT_ID=
# SAMPLE_GOOGLE_ORG_CALENDAR_CLIENT_SECRET=
# SAMPLE_GOOGLE_ORG_CALENDAR_REDIRECT_URI=
# Required for private uploads: malware scanner host, port, CA, client cert and key,
# pinned SPKI, minimum engine. Any missing: 503. docs/security/private-upload-inspection.md.
# PRIVATE_FILE_SCANNER_HOST=
# PRIVATE_FILE_SCANNER_PORT=
# PRIVATE_FILE_SCANNER_CA=
# PRIVATE_FILE_SCANNER_CERT=
# PRIVATE_FILE_SCANNER_KEY=
# PRIVATE_FILE_SCANNER_EXPECTED_SPKI=
# PRIVATE_FILE_SCANNER_ENGINE_MIN=
# SAMPLE_PRIVATE_FILE_SCANNER_HOST=
# SAMPLE_PRIVATE_FILE_SCANNER_PORT=
# SAMPLE_PRIVATE_FILE_SCANNER_CA=
# SAMPLE_PRIVATE_FILE_SCANNER_CERT=
# SAMPLE_PRIVATE_FILE_SCANNER_KEY=
# SAMPLE_PRIVATE_FILE_SCANNER_EXPECTED_SPKI=
# SAMPLE_PRIVATE_FILE_SCANNER_ENGINE_MIN=
# SAMPLE twins of native push and SUPABASE_AUTH_FORWARD_CLIENT_IP above.
# SAMPLE_APNS_TEAM_ID=
# SAMPLE_APNS_KEY_ID=
# SAMPLE_APNS_PRIVATE_KEY=
# SAMPLE_APNS_BUNDLE_ID=
# SAMPLE_FCM_SERVICE_ACCOUNT_JSON=
# SAMPLE_SUPABASE_AUTH_FORWARD_CLIENT_IP=1
# Bearer the SAMPLE database tick sends to /api/task-files-reconcile; not CRON_SECRET.
# SAMPLE_TASK_FILES_RECONCILE_SECRET=replace-with-a-different-long-random-sample-secret
# SAMPLE persona authenticators (JSON); unset, staff personas stop at the code screen.
# SAMPLE_DEMO_PERSONA_AUTHENTICATORS=replace-with-sample-persona-authenticator-json
# SAMPLE invitation proof: all together; switches off at the expiry. Never set for
# production. The origin must be exactly the SAMPLE site, demo.example.com (not production).
# The expiry must be a UTC instant after now and at most 24 hours ahead, or the
# proof stays off; the example instant below is only its shape.
# SAMPLE_INVITATION_PROOF_ENABLED=true
# SAMPLE_INVITATION_PROOF_EXPIRES_AT=2026-01-01T00:00:00Z
# SAMPLE_INVITATION_APP_ORIGIN=https://demo.example.com
# SAMPLE_INVITATION_ALLOWED_EMAILS=tester@example.invalid
# SAMPLE_INVITATION_NOTIFY_FROM_ADDRESS=Union Ground SAMPLE <alerts@example.invalid>
# SAMPLE_INVITATION_RATE_LIMIT_SECRET=
# SAMPLE_INVITATION_RESEND_API_KEY=replace-with-sample-resend-api-key

# Set the HTTPS origin of this deployment to reuse assets in hosted builds.
ASSET_CARRY_PRODUCTION_ORIGIN=
