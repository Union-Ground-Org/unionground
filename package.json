{
  "name": "unionground",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "vite",
    "dev:preview": "node scripts/dev-preview.mjs",
    "build": "vite build && node scripts/prune-deployed-design.mjs && node scripts/verify-public-route-build.mjs && node scripts/verify-runtime-config-isolation.mjs && node scripts/carry-previous-assets.mjs",
    "build:assurance": "vite build --mode test && node scripts/prune-deployed-design.mjs && node scripts/verify-public-route-build.mjs && node scripts/verify-runtime-config-isolation.mjs",
    "build:demo": "node scripts/build-demo-site.mjs",
    "preview": "vite preview",
    "test": "vitest run --pool=threads",
    "test:coverage": "vitest run --coverage --pool=threads",
    "test:mobile": "npm --prefix apps/mobile test -- --run",
    "coverage:verify": "node scripts/verify-coverage-ratchet.mjs",
    "coverage:update-baseline": "npm run test:coverage && node scripts/verify-coverage-ratchet.mjs --update",
    "test:visual": "node scripts/visual-audit-runner.mjs",
    "test:visual:fixture": "node scripts/visual-audit-runner.mjs --fixture",
    "lint": "eslint src api scripts demo-bots vite.config.mjs eslint.config.js",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "verify:db": "node --env-file-if-exists=.env.local scripts/verify-db-contract.mjs",
    "verify:migrations": "node --env-file-if-exists=.env.local scripts/verify-migration-history.mjs",
    "verify:conventions": "node scripts/verify-repository-conventions.mjs",
    "verify:licenses": "node scripts/check-licenses.mjs",
    "verify:db-repair-proofs": "node scripts/run-required-db-proofs.mjs",
    "verify:db:assurance": "node scripts/run-database-assurance.mjs",
    "verify:mi1-w2": "node scripts/verify-mi1-w2-feature-persistence.mjs",
    "verify:mi1-organization-scope": "node scripts/verify-mi1-organization-scope.mjs",
    "verify:mi1-casework": "node scripts/verify-mi1-casework-suite.mjs",
    "verify:case-search-db": "RUN_CASE_SEARCH_DB_TESTS=1 vitest run tests/member-case-search-db.test.js",
    "verify:mi1-w2:live": "node --env-file-if-exists=.env.local scripts/verify-mi1-w2-feature-persistence.mjs --live",
    "verify:member-engagement": "node scripts/verify-member-engagement-behaviour.mjs",
    "verify:member-engagement:live": "node scripts/verify-member-engagement-behaviour.mjs --live",
    "verify:voice-surveys:local": "node scripts/verify-voice-survey-completion.mjs",
    "verify:institutional-records:local": "node scripts/verify-institutional-records-local.mjs",
    "verify:member-operations:local": "node scripts/verify-member-operations-local.mjs",
    "atlas:plan": "node scripts/load-union-orgs.mjs plan",
    "atlas:load": "node scripts/load-union-orgs.mjs load",
    "atlas:verify": "node scripts/load-union-orgs.mjs verify",
    "catalog:export": "node scripts/union-catalog/export-release.mjs",
    "catalog:plan": "node scripts/load-union-catalog.mjs plan",
    "catalog:load": "node scripts/load-union-catalog.mjs load",
    "catalog:verify": "node scripts/load-union-catalog.mjs verify",
    "catalog:activate": "node scripts/load-union-catalog.mjs activate",
    "verify:rpc": "node --env-file-if-exists=.env.local scripts/verify-rpc-behaviour.mjs",
    "verify:rpc:authorized": "node --env-file-if-exists=.env.local scripts/verify-rpc-behaviour-authorized.mjs",
    "verify:task-comment:no-fiction": "node --env-file-if-exists=.env.local scripts/verify-task-comment-no-fiction.mjs",
    "verify:ai-governance": "node scripts/verify-ai-governance.mjs",
    "verify:ai-evals": "vitest run tests/compass-behavior-evals.test.js tests/compass-live-evals.test.js --pool=threads --maxWorkers=2",
    "eval:compass:live": "node scripts/eval-compass-live.mjs",
    "verify:api-origin": "node scripts/verify-api-origin-contract.mjs",
    "verify:env-fallback-ban": "node scripts/verify-env-fallback-ban.mjs",
    "quality:static": "node scripts/verify-static-quality.mjs",
    "quality:static:report": "node scripts/verify-static-quality.mjs --report",
    "quality:static:update": "node scripts/verify-static-quality.mjs --update",
    "security:scan": "node scripts/run-security-scan.mjs all",
    "security:scan:self-test": "node scripts/run-security-scan.mjs self-test",
    "security:scan:history": "node scripts/run-security-scan.mjs gitleaks-history",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:verify": "node scripts/generate-sbom.mjs --verify",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "verify:ai-governance:local": "node --env-file-if-exists=.env.local scripts/verify-compass-ai-governance-local.mjs",
    "verify:chapter-events:local": "node --env-file-if-exists=.env.local scripts/verify-chapter-events-local.mjs",
    "verify:chapter-standing:local": "node scripts/verify-chapter-standing-burst-local.mjs",
    "verify:civic-rls:local": "node scripts/verify-civic-rls-local.mjs",
    "verify:event-scan-concurrency:local": "node --env-file-if-exists=.env.local scripts/verify-event-scan-concurrency-local.mjs",
    "verify:account-lifecycle:local": "node --env-file-if-exists=.env.local scripts/verify-member-account-lifecycle-local.mjs",
    "verify:account-lifecycle-manifest:local": "node --env-file-if-exists=.env.local scripts/verify-account-lifecycle-manifest-local.mjs",
    "verify:account-deletion-finalization:local": "node --env-file-if-exists=.env.local scripts/verify-account-deletion-finalization-local.mjs",
    "verify:admin-command:local": "node --env-file-if-exists=.env.local scripts/verify-admin-command-center-local.mjs",
    "verify:automation:local": "node --env-file-if-exists=.env.local scripts/verify-mi1-automation-control-local.mjs",
    "verify:automation:v3:local": "node --env-file-if-exists=.env.local scripts/verify-automation-shared-intelligence-v3-local.mjs",
    "verify:automation:concurrency-local": "node scripts/verify-connected-automation-concurrency-local.mjs",
    "verify:retention:local": "node --env-file-if-exists=.env.local scripts/verify-mi1-retention-engine-local.mjs",
    "verify:twilio-rate-limits:local": "node scripts/verify-twilio-sms-rate-limits-local.mjs",
    "verify:messaging:local": "node --env-file-if-exists=.env.local scripts/verify-unified-messaging-local.mjs",
    "verify:form-concurrency:local": "node --env-file-if-exists=.env.local scripts/verify-form-filing-concurrency-local.mjs",
    "verify:task-templates:local": "node scripts/verify-specialized-task-templates-local.mjs",
    "verify:task-templates:concurrency-local": "node scripts/verify-specialized-task-template-concurrency-local.mjs",
    "verify:reward-contact:local": "node --env-file-if-exists=.env.local scripts/verify-reward-peer-contact-local.mjs",
    "verify:public-interest:local": "node --env-file-if-exists=.env.local scripts/verify-public-interest-submission-local.mjs",
    "contrast:audit": "node scripts/contrast-audit.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:status": "supabase status",
    "verify:db-boundary:local": "node --env-file-if-exists=.env.local scripts/verify-db-boundary-tenancy.mjs",
    "verify:mobile-app-links": "node scripts/verify-mobile-app-links.mjs",
    "verify:mobile-app-links:dist": "node scripts/verify-mobile-app-links.mjs --dist",
    "verify:web-bundle-identity": "node scripts/verify-web-bundle-identity.mjs --dist-dir dist",
    "sync:mobile-app-links": "node scripts/sync-mobile-app-links.mjs",
    "sync:messaging-contract": "node scripts/sync-messaging-contract.mjs",
    "verify:messaging-contract": "node scripts/sync-messaging-contract.mjs --check",
    "verify:mobile-release-foundation": "node scripts/verify-mobile-release-foundation.mjs",
    "preflight:mobile-release": "node scripts/verify-mobile-release-foundation.mjs",
    "test:unionground-db": "node scripts/verify-unionground-db.mjs",
    "test:rls": "node scripts/unionground-legacy-rls-disabled.mjs",
    "bots:demo": "node demo-bots/run.mjs run",
    "check": "npm run lint && npm run contrast:audit && npm run verify:api-origin && npm run verify:messaging-contract && npm run verify:env-fallback-ban && npm run sbom:check && npm run verify:mi1-w2 && npm run verify:mi1-organization-scope && npm run verify:mi1-casework && npm run test && npm run build && npm run verify:web-bundle-identity && npm run verify:mobile-app-links:dist",
    "verify:db-grant-parity": "node scripts/verify-db-contract-grant-parity.mjs"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "@sentry/core": "11.17.0",
    "@sentry/react": "^11.15.0",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/functions": "3.11.3",
    "bidi-js": "1.1.0",
    "canvas-confetti": "1.9.4",
    "fflate": "^0.8.3",
    "harfbuzzjs": "1.6.4",
    "lucide-react": "1.77.0",
    "pdf-lib": "1.17.1",
    "posthog-js": "^1.438.19",
    "posthog-node": "5.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "unpdf": "1.9.1",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "8.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@sentry/vite-plugin": "^11.15.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "chrome-launcher": "1.2.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "espree": "11.2.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "31.0.1",
    "jsqr": "^1.4.0",
    "lighthouse": "13.6.0",
    "pg": "^8.23.1",
    "puppeteer-core": "25.18.1",
    "supabase": "2.122.1",
    "typescript-compiler-api": "npm:typescript@6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "sharp": "0.35.5",
    "qs": "6.17.1",
    "minimatch": "11.0.4",
    "zod": "$zod"
  }
}
